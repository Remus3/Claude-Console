{
  "schema": 1,
  "id": "docs-memory",
  "order": 9,
  "title": "Docs, memory and size budgets",
  "summary": "Size budgets with a checker, a memory layout, an open-only roadmap, briefs, rulings and the hand-off archive, plus commands that keep them in sync.",
  "why": "Context is the budget every session spends first. A file past its budget is paid for on every turn, and deleting detail destroys what the budget is meant to protect, so detail is relocated instead.",
  "default": "on",
  "items": [
    {
      "id": "conv-doc-size-budget",
      "order": 901,
      "title": "Size budgets: relocate, never delete",
      "does": "Adds the budget rule and .claude/doc-budgets.json with your budgets: CLAUDE.md and auto-loaded files, the memory index and leaves, the roadmap, the hand-off and agent files.",
      "why": "A document past its budget costs context on every turn of every session; moving detail out with a pointer keeps it reachable at no standing cost.",
      "risk": "low",
      "default": "on",
      "platform": [
        "win32",
        "darwin",
        "linux"
      ],
      "depends_on": [],
      "pairs_with": [
        "tool-doc-budget"
      ],
      "conflicts_with": [],
      "contributes": [
        {
          "kind": "block",
          "target": "repo:CLAUDE.md",
          "block": "rules",
          "template": "templates/rules/conv-doc-size-budget.md"
        },
        {
          "kind": "file",
          "target": "repo:.claude/doc-budgets.json",
          "template": "templates/doc-budgets.json",
          "mode": "replace-ask"
        }
      ],
      "detect": [
        {
          "file": "repo:.claude/doc-budgets.json"
        }
      ],
      "verify": [
        {
          "json-parse": "repo:.claude/doc-budgets.json"
        }
      ]
    },
    {
      "id": "tool-doc-budget",
      "order": 902,
      "title": "Budget checker",
      "does": "Installs doc_budget.py, which prints every budgeted file against its budget and exits non-zero only on a hard limit.",
      "why": "A warning that blocks a commit gets switched off and then enforces nothing, so warnings here never block.",
      "risk": "low",
      "default": "on",
      "platform": [
        "win32",
        "darwin",
        "linux"
      ],
      "depends_on": [
        "conv-doc-size-budget"
      ],
      "pairs_with": [],
      "conflicts_with": [],
      "contributes": [
        {
          "kind": "file",
          "target": "repo:.claude/tools/doc_budget.py",
          "template": "templates/tools/doc_budget.py",
          "mode": "managed"
        }
      ],
      "detect": [
        {
          "file": "repo:.claude/tools/doc_budget.py"
        }
      ],
      "verify": [
        {
          "budget": "claude_md_kb"
        }
      ]
    },
    {
      "id": "conv-memory-layout",
      "order": 903,
      "title": "Memory index with one fact per leaf",
      "does": "Adds the memory rule and starts the project memory with an index and one example leaf in the Claude config dir.",
      "why": "A fact measured once and not written down gets probed again by the next session; small leaves keep each fact cheap to load.",
      "risk": "low",
      "default": "on",
      "platform": [
        "win32",
        "darwin",
        "linux"
      ],
      "depends_on": [],
      "pairs_with": [
        "conv-doc-size-budget"
      ],
      "conflicts_with": [],
      "contributes": [
        {
          "kind": "block",
          "target": "repo:CLAUDE.md",
          "block": "rules",
          "template": "templates/rules/conv-memory-layout.md"
        },
        {
          "kind": "file",
          "target": "user:projects/{project_slug}/memory/MEMORY.md",
          "template": "templates/memory/MEMORY.md",
          "mode": "create-only"
        },
        {
          "kind": "file",
          "target": "user:projects/{project_slug}/memory/example-leaf.md",
          "template": "templates/memory/example-leaf.md",
          "mode": "create-only"
        }
      ],
      "detect": [
        {
          "file": "user:projects/{project_slug}/memory/MEMORY.md"
        }
      ],
      "scope": "template"
    },
    {
      "id": "conv-roadmap-open-only",
      "order": 904,
      "title": "Roadmap of open work only",
      "does": "Creates ROADMAP.md and the rule that it lists open items only, each with an acceptance check.",
      "why": "A roadmap that keeps closed items hides the open ones among them.",
      "risk": "low",
      "default": "on",
      "platform": [
        "win32",
        "darwin",
        "linux"
      ],
      "depends_on": [],
      "pairs_with": [],
      "conflicts_with": [],
      "contributes": [
        {
          "kind": "file",
          "target": "repo:ROADMAP.md",
          "template": "templates/ROADMAP.md",
          "mode": "create-only"
        },
        {
          "kind": "block",
          "target": "repo:CLAUDE.md",
          "block": "rules",
          "template": "templates/rules/conv-roadmap-open-only.md"
        }
      ],
      "detect": [
        {
          "file": "repo:ROADMAP.md"
        }
      ],
      "verify": [
        {
          "budget": "roadmap_kb"
        }
      ]
    },
    {
      "id": "conv-docs-briefs",
      "order": 905,
      "title": "Docs as standing briefs",
      "does": "Adds the rule that the docs folder holds one dated brief per workstream, and a README that says so.",
      "why": "Hand-offs kept in the docs folder drifted out of date; briefs hold the facts that last.",
      "risk": "low",
      "default": "on",
      "platform": [
        "win32",
        "darwin",
        "linux"
      ],
      "depends_on": [],
      "pairs_with": [],
      "conflicts_with": [],
      "contributes": [
        {
          "kind": "block",
          "target": "repo:CLAUDE.md",
          "block": "rules",
          "template": "templates/rules/conv-docs-briefs.md"
        },
        {
          "kind": "file",
          "target": "repo:{docs_dir}/README.md",
          "template": "templates/briefs-README.md",
          "mode": "create-only"
        }
      ],
      "detect": [
        {
          "file": "repo:{docs_dir}/README.md"
        }
      ]
    },
    {
      "id": "conv-rulings-dir",
      "order": 906,
      "title": "Rulings folder",
      "does": "Creates the rulings folder with its record format: decision, alternatives, why, and what would reverse it.",
      "why": "An adjudicated call must be auditable and reversible, which needs it written down in one known place.",
      "risk": "low",
      "default": "on",
      "platform": [
        "win32",
        "darwin",
        "linux"
      ],
      "depends_on": [
        "rule-act-dont-ask"
      ],
      "pairs_with": [],
      "conflicts_with": [],
      "contributes": [
        {
          "kind": "block",
          "target": "repo:CLAUDE.md",
          "block": "rules",
          "template": "templates/rules/conv-rulings-dir.md"
        },
        {
          "kind": "file",
          "target": "repo:{docs_dir}/rulings/README.md",
