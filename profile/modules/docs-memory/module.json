          "mode": "managed"
        },
        {
          "kind": "block",
          "target": "repo:.claude/commands/done.md",
          "block": "done-handoff-lint",
          "template": "templates/done/handoff-lint.md"
        }
      ],
      "detect": [
        {
          "file": "repo:.claude/tools/handoff_lint.py"
        }
      ]
    },
    {
      "id": "md-handoff-prefix-grammar",
      "order": 916,
      "title": "Hand-off bullet prefixes",
      "does": "Adds the rule that a bullet's prefix decides where it goes: a note, another repository, an act for you, or lane work.",
      "why": "Rewording a carried bullet once made a background loop dispatch it again as new work. Useful only with background lanes.",
      "risk": "low",
      "default": "off",
      "platform": [
        "win32",
        "darwin",
        "linux"
      ],
      "depends_on": [
