          "file": "repo:{docs_dir}/rulings/*"
        }
      ]
    },
    {
      "id": "conv-handoff-archive",
      "order": 907,
      "title": "Hand-off archive",
      "does": "Creates the hand-off archive folder and the /done step that moves closed hand-off blocks into it before the size cap is reached.",
      "why": "The done marker refuses an oversized hand-off; archiving closed blocks keeps it under the cap without losing them.",
      "risk": "low",
      "default": "on",
      "platform": [
        "win32",
        "darwin",
        "linux"
      ],
      "depends_on": [
        "conv-handoff-file",
        "conv-doc-size-budget"
      ],
      "pairs_with": [
        "md-handoff-cap"
      ],
      "conflicts_with": [],
      "contributes": [
        {
          "kind": "file",
          "target": "repo:{docs_dir}/handoff-archive/README.md",
          "template": "templates/handoff-archive-README.md",
          "mode": "create-only"
        },
        {
          "kind": "block",
          "target": "repo:.claude/commands/done.md",
          "block": "done-handoff-archive",
          "template": "templates/done/handoff-archive.md"
        }
      ],
      "detect": [
        {
          "file": "repo:{docs_dir}/handoff-archive/*"
        }
      ]
    },
    {
      "id": "cmd-sync-docs",
      "order": 908,
      "title": "/sync-docs",
      "does": "Installs a command that reconciles every markdown file against its owning source, fixes drift and flags broken references and stale files.",
      "why": "Numbers restated in several files drift apart quietly until a session acts on the wrong one.",
      "risk": "low",
      "default": "on",
      "platform": [
        "win32",
        "darwin",
        "linux"
      ],
      "depends_on": [],
      "pairs_with": [
        "agent-doc-sync"
      ],
      "conflicts_with": [],
      "contributes": [
        {
          "kind": "file",
          "target": "repo:.claude/commands/sync-docs.md",
          "template": "templates/commands/sync-docs.md",
          "mode": "managed"
        }
      ],
      "detect": [
        {
          "file": "repo:.claude/commands/sync-docs.md"
        }
      ]
    },
    {
      "id": "cmd-weekly-hygiene",
      "order": 909,
      "title": "/weekly-hygiene",
      "does": "Installs a weekly command: relocate-only trims of files near their budget, a memory staleness scan and a look at recent session start-ups.",
      "why": "Budgets only hold when someone trims a little every week instead of a lot once things break.",
      "risk": "low",
      "default": "on",
      "platform": [
        "win32",
        "darwin",
        "linux"
      ],
      "depends_on": [
        "conv-doc-size-budget"
      ],
      "pairs_with": [],
      "conflicts_with": [],
      "contributes": [
        {
          "kind": "file",
          "target": "repo:.claude/commands/weekly-hygiene.md",
          "template": "templates/commands/weekly-hygiene.md",
          "mode": "managed"
        }
      ],
      "detect": [
        {
          "file": "repo:.claude/commands/weekly-hygiene.md"
        }
      ]
    },
    {
      "id": "hook-facts-inject",
      "order": 910,
      "title": "Facts file injected at start-up",
      "does": "Creates .claude/facts.md and a SessionStart hook that prints it (at most 20 lines) so sessions start with verified state.",
      "why": "Injecting a short fact block is cheaper than having every session re-read files to rediscover it.",
      "risk": "low",
      "default": "off",
      "platform": [
        "win32",
        "darwin",
        "linux"
      ],
      "depends_on": [],
      "pairs_with": [],
      "conflicts_with": [],
      "contributes": [
        {
          "kind": "file",
          "target": "repo:.claude/facts.md",
          "template": "templates/facts.md",
          "mode": "create-only"
        },
        {
          "kind": "file",
          "target": "repo:.claude/hooks/facts_inject.py",
          "template": "templates/hooks/facts_inject.py",
          "mode": "managed"
        },
        {
          "kind": "json-merge",
          "target": "repo:.claude/settings.json",
          "value": {
            "hooks": {
              "SessionStart": [
                {
                  "hooks": [
                    {
                      "type": "command",
                      "command": "\"{python}\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/facts_inject.py\"",
                      "timeout": 5
                    }
                  ]
                }
              ]
            }
          },
          "mode": "add"
        }
      ],
      "detect": [
        {
          "file": "repo:.claude/facts.md"
        }
      ],
      "verify": [
        {
          "hook-smoke": "repo:.claude/settings.json"
        }
      ],
      "scope": "template"
    },
    {
      "id": "hook-edit-guards",
      "order": 911,
      "title": "ASCII and LF check after each edit",
      "does": "Adds a PostToolUse hook that checks the file just edited or written and reports the first line with a CR or a non-ASCII byte.",
      "why": "An encoding fault caught at the edit costs one line; caught at commit time it costs a hunt. Your own linters stay yours to add.",
      "risk": "low",
      "default": "off",
      "platform": [
        "win32",
        "darwin",
        "linux"
      ],
      "depends_on": [],
      "pairs_with": [
        "rule-encoding-ascii-lf"
      ],
      "conflicts_with": [],
      "contributes": [
        {
          "kind": "file",
          "target": "repo:.claude/hooks/ascii_lf_guard.py",
          "template": "templates/hooks/ascii_lf_guard.py",
          "mode": "managed"
        },
        {
          "kind": "json-merge",
          "target": "repo:.claude/settings.json",
          "value": {
            "hooks": {
              "PostToolUse": [
                {
                  "matcher": "Edit|Write|MultiEdit|NotebookEdit",
                  "hooks": [
                    {
                      "type": "command",
                      "command": "\"{python}\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/ascii_lf_guard.py\"",
                      "timeout": 10
                    }
                  ]
                }
              ]
            }
          },
          "mode": "add"
        }
      ],
      "detect": [
        {
          "text": "repo:.claude/settings.json",
          "regex": "ascii_lf_guard"
        }
      ],
      "verify": [
        {
          "hook-smoke": "repo:.claude/settings.json"
        }
      ],
      "scope": "template"
    },
    {
      "id": "hook-precommit-gate",
      "order": 912,
      "title": "Gate on commit tool calls",
      "does": "Adds a PreToolUse hook that runs the budget checker before a git commit tool call and denies the call on a hard failure.",
      "why": "A red commit costs a revert; refusing the tool call is cheaper. The git hooks stay the authoritative gate.",
      "risk": "low",
      "default": "off",
      "platform": [
        "win32",
        "darwin",
        "linux"
      ],
      "depends_on": [
        "tool-doc-budget"
      ],
      "pairs_with": [],
      "conflicts_with": [],
      "contributes": [
        {
          "kind": "file",
          "target": "repo:.claude/hooks/precommit_gate.py",
          "template": "templates/hooks/precommit_gate.py",
          "mode": "managed"
        },
        {
          "kind": "json-merge",
          "target": "repo:.claude/settings.json",
          "value": {
            "hooks": {
              "PreToolUse": [
                {
                  "matcher": "Bash|PowerShell",
                  "hooks": [
                    {
                      "type": "command",
                      "command": "\"{python}\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/precommit_gate.py\"",
                      "timeout": 10
                    }
                  ]
                }
              ]
            }
          },
          "mode": "add"
        }
      ],
      "detect": [
        {
          "text": "repo:.claude/settings.json",
          "regex": "precommit_gate"
        }
      ],
      "verify": [
        {
          "hook-smoke": "repo:.claude/settings.json"
        }
      ],
      "scope": "template"
    },
    {
      "id": "hook-claimed-green-gate",
      "order": 913,
      "title": "Flag green claims without a test run",
      "does": "Adds a Stop hook that notices a reply claiming the tests pass when no test command ran in that turn, and says so in one line.",
      "why": "Unverified success claims are the most expensive kind of wrong report. The hook informs and never blocks Stop.",
      "risk": "low",
      "default": "off",
      "platform": [
        "win32",
        "darwin",
        "linux"
      ],
      "depends_on": [
        "rule-hook-output"
      ],
      "pairs_with": [],
      "conflicts_with": [],
      "contributes": [
        {
          "kind": "file",
          "target": "repo:.claude/hooks/claimed_green_gate.py",
          "template": "templates/hooks/claimed_green_gate.py",
          "mode": "managed"
        },
        {
          "kind": "json-merge",
          "target": "repo:.claude/settings.json",
          "value": {
            "hooks": {
              "Stop": [
                {
                  "hooks": [
                    {
                      "type": "command",
                      "command": "\"{python}\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/claimed_green_gate.py\"",
                      "timeout": 10
                    }
                  ]
                }
              ]
            }
          },
          "mode": "add"
        }
      ],
      "detect": [
        {
          "text": "repo:.claude/settings.json",
          "regex": "claimed_green"
        }
      ],
      "verify": [
        {
          "hook-smoke": "repo:.claude/settings.json"
        }
      ],
      "scope": "template"
    },
    {
      "id": "md-handoff-cap",
      "order": 914,
      "title": "Hand-off size cap at /done",
      "does": "Adds the rule that the done marker refuses a hand-off over its budget and warns at 90 percent.",
      "why": "The largest hand-off seen reached 164 KB, roughly 36,000 tokens loaded at the start of every session.",
      "risk": "low",
      "default": "on",
      "platform": [
        "win32",
        "darwin",
        "linux"
      ],
      "depends_on": [
        "conv-handoff-file",
        "kit-fleet-done"
      ],
      "pairs_with": [
        "conv-handoff-archive"
      ],
      "conflicts_with": [],
      "contributes": [
        {
          "kind": "block",
          "target": "repo:CLAUDE.md",
          "block": "rules",
          "template": "templates/rules/md-handoff-cap.md"
        }
      ],
      "verify": [
        {
          "budget": "handoff_kb"
        }
      ]
    },
    {
      "id": "md-handoff-lint",
      "order": 915,
      "title": "Hand-off lint",
      "does": "Installs handoff_lint.py and its /done step: at least 2,000 bytes, one SESSION line on line 1, at most one fenced block, ASCII, no secret-shaped strings or home paths.",
      "why": "A truncated hand-off once lost the next action, and secrets and paths have leaked through hand-offs before.",
      "risk": "low",
      "default": "on",
      "platform": [
        "win32",
        "darwin",
        "linux"
      ],
      "depends_on": [
        "conv-handoff-file"
      ],
      "pairs_with": [],
      "conflicts_with": [],
      "contributes": [
