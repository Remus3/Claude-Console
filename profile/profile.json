{
  "schema": 1,
  "profile": "operator-workflow",
  "version": "1.0.0",
  "console_min": "0.1.3",
  "kit_source_version": 20,
  "modules": [
    "floors",
    "core-rules",
    "session",
    "output",
    "subagent-first",
    "race-guards",
    "attribution",
    "tdd-agents",
    "docs-memory",
    "fleet",
    "headless",
    "maintenance",
    "insights",
    "board",
    "console",
    "ci-gates",
    "recall",
    "lessons",
    "permissions-context",
    "sidecar",
    "runtime-agents",
    "machine-profile"
  ],
  "presets": {
    "recommended": [
      "floors",
      "core-rules",
      "session",
      "output",
      "attribution",
      "tdd-agents",
      "docs-memory",
      "console",
      "ci-gates",
      "recall",
      "lessons",
      "permissions-context"
    ],
    "minimal": [
      "floors",
      "core-rules",
      "session",
      "attribution",
      "lessons"
    ],
    "full": "*"
  },
  "variables": {
    "repo_code": {
      "type": "code",
      "pattern": "^[A-Z][A-Z0-9]{1,5}$",
      "ask": "wizard.step.repo",
      "why": "Short code used in the hand-off file name, the status line and channel notes."
    },
    "repo_root": {
      "type": "path",
      "scope": "target"
    },
    "kit_dir": {
      "type": "relpath",
      "default": "ops/kit",
      "why": "Where the kit files are copied in each repository."
    },
    "docs_dir": {
      "type": "relpath",
      "default": "docs",
      "why": "Folder that holds the repo docs: briefs, rulings, lessons, registers and archives."
    },
    "runtime_dir": {
      "type": "relpath",
      "default": "ops/runtime",
      "why": "Scripts that scheduled tasks run directly."
    },
    "control_dir": {
      "type": "relpath",
      "default": "ops/loop/control",
      "why": "Progress files, markers, logs and halt files the kit reads and writes."
    },
    "handoff_name": {
      "type": "derived",
      "value": "{repo_code}-NEXT-SESSION.txt"
    },
    "python": {
      "type": "exe",
      "detect": "python",
      "why": "Runs the kit hooks and tools."
    },
    "node": {
      "type": "exe",
      "detect": "node",
      "why": "Runs the status line scripts."
    },
    "config_dir": {
      "type": "path",
      "detect": "claude-config-dir"
    },
    "project_slug": {
      "type": "string",
      "detect": "claude-project-slug",
      "why": "The folder name Claude uses for this repository's transcripts and memory."
    },
    "headless_config_dir": {
      "type": "path",
      "optional": true,
      "ask": "wizard.step.accounts"
    },
    "headless_base_url": {
      "type": "url",
      "pattern": "^http://127\\.0\\.0\\.1:[0-9]{2,5}/?$",
      "optional": true,
      "ask": "wizard.step.headless"
    },
    "operator_ident": {
      "type": "git-ident",
      "secret": false,
      "store": "git-config-local",
      "ask": "wizard.step.identity",
      "why": "Your own commit identity; it lives only in this repository's local git config."
    },
    "inbox_dir": {
      "type": "relpath",
      "default": "inbox"
    },
    "outbox_dir": {
      "type": "relpath",
      "default": "outbox"
    },
    "reports_dir": {
      "type": "path",
      "default": "{documents}/Claude Reports"
    },
    "suite_slots": {
      "type": "int",
      "default": 2,
      "min": 1,
      "max": 4,
      "why": "Whole test suites allowed to run at once on this machine."
    },
    "budgets": {
      "type": "object",
      "default": {
        "claude_md_kb": 40,
        "auto_loaded_kb": 40,
        "memory_index_kb": 20,
        "memory_leaf_kb": 6,
        "roadmap_kb": 60,
        "handoff_kb": 30,
        "handoff_warn_pct": 90,
        "agent_file_kb": 3
      }
    },
    "retention_days": {
      "type": "int",
      "default": null,
      "measure": "transcript-age-histogram",
      "why": "Days a top-level session transcript is kept."
    },
    "retention_nested_days": {
      "type": "int",
      "default": null,
      "measure": "transcript-age-histogram",
      "why": "Days a sub-agent transcript is kept."
    },
    "max_subagents": {
      "type": "int",
      "default": 10,
      "min": 1,
      "max": 64
    },
    "effort_level": {
      "type": "string",
      "pattern": "^(low|medium|high|xhigh|max)$",
      "optional": true,
      "ask": "wizard.step.modules"
    },
    "refute_rounds": {
      "type": "int",
      "default": 2,
      "min": 1,
      "max": 5
    },
    "headless_runs_per_day": {
      "type": "int",
      "default": 120,
      "min": 1,
      "max": 500
    },
    "backup_target": {
      "type": "ssh-alias",
      "optional": true,
      "ask": "wizard.step.tasks"
    },
    "wol_mac": {
      "type": "string",
      "pattern": "^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$",
      "optional": true,
      "ask": "wizard.step.tasks"
    },
    "board_url": {
      "type": "url",
      "pattern": "^https://claude\\.ai/",
      "optional": true,
      "ask": "wizard.step.accounts"
    },
    "sidecar_root": {
      "type": "path",
      "default": "{data_dir}/sidecars",
      "ask": "wizard.step.sidecar",
      "optional": true,
      "why": "Root of the per-repo sidecar areas outside the repo."
    },
    "sidecar_retention_days": {
      "type": "int",
      "default": null,
      "measure": "sidecar-age-histogram"
    },
    "runtime_retention_days": {
      "type": "int",
      "default": null,
      "measure": "runtime-age-histogram"
    }
  }
}
