{
  "schema": 1,
  "profile": "fixture-min",
  "version": "1.0.0",
  "console_min": "0.1.3",
  "kit_source_version": 20,
  "modules": ["floors", "session"],
  "presets": {
    "recommended": ["floors", "session"],
    "minimal": ["floors"],
    "full": "*"
  },
  "variables": {
    "repo_code": {"type": "code", "pattern": "^[A-Z][A-Z0-9]{1,5}$", "ask": "wizard.step.repo",
                  "why": "Short code used in the hand-off file name and status line."},
    "repo_root": {"type": "path", "scope": "target"},
    "kit_dir": {"type": "relpath", "default": "ops/kit"},
    "handoff_name": {"type": "derived", "value": "{repo_code}-NEXT-SESSION.txt"},
    "python": {"type": "exe", "detect": "python", "why": "Runs the kit hooks."},
    "reports_dir": {"type": "path", "default": "{documents}/Claude Reports"},
    "suite_slots": {"type": "int", "default": 2, "min": 1, "max": 8},
    "retention_days": {"type": "int", "default": null, "measure": "transcript-age-histogram"},
    "headless_base_url": {"type": "url", "pattern": "^http://127\\.0\\.0\\.1:[0-9]{2,5}/?$", "optional": true}
  }
}
