{
  "schema": 1,
  "note": "Allowed network hosts and the baseline of network-capable code (CON-013 addendum e.1). No telemetry, ever. A new hit, host or a loopback-only file gaining a non-loopback target fails the no-egress tests.",
  "loopback": [
    "127.0.0.1",
    "localhost",
    "::1"
  ],
  "hosts": [
    {
      "host": "api.github.com",
      "kind": "update",
      "use": "release list (update check)"
    },
    {
      "host": "github.com",
      "kind": "update",
      "use": "release download (redirects to the asset host)"
    },
    {
      "host": "objects.githubusercontent.com",
      "kind": "update",
      "use": "release asset download"
    },
    {
      "host": "release-assets.githubusercontent.com",
      "kind": "update",
      "use": "release asset download"
    },
    {
      "host": "github.com",
      "kind": "browser",
      "use": "issue page, opened in the browser after a click"
    },
    {
      "host": "claude.ai",
      "kind": "browser",
      "use": "help chat, opened in the browser after a click"
    },
    {
      "host": "api.anthropic.com",
      "kind": "credits",
      "optIn": true,
      "use": "month-to-date API spend (Admin key cost report); only after the user turns it on in Settings"
    }
  ],
  "files": [
    {
      "file": "installer/autoupdate.js",
      "class": "loopback",
      "hosts": [
        "127.0.0.1"
      ],
      "use": "asks the local server whether panes are busy before a restart"
    },
    {
      "file": "installer/cli.js",
      "class": "loopback",
      "hosts": [
        "127.0.0.1"
      ],
      "use": "POST /api/shutdown to the local server"
    },
    {
      "file": "installer/contribute.js",
      "class": "browser",
      "hosts": [
        "github.com"
      ],
      "use": "issue URL for a contribution, opened after a click"
    },
    {
      "file": "installer/crashreport.js",
      "class": "browser",
      "hosts": [
        "github.com",
        "claude.ai"
      ],
      "use": "crash report issue page, opened after a click"
    },
    {
      "file": "installer/detect.js",
      "class": "loopback",
      "hosts": [
        "127.0.0.1"
      ],
      "use": "probes the local server"
    },
    {
      "file": "installer/egress.js",
